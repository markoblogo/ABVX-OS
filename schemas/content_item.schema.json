{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/content-item/v1",
  "title": "ABVX Content Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project",
    "surface",
    "kind",
    "title",
    "slug",
    "summary",
    "locales",
    "status",
    "payload",
    "adapter",
    "validation",
    "human_gate",
    "publication",
    "artifact_refs",
    "history",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "status": {
      "enum": [
        "PREPARED",
        "BLOCKED",
        "APPROVED",
        "PUBLISH_PACKET_EMITTED"
      ]
    },
    "payload": {
      "$ref": "content_fixture.schema.json#/properties/payload"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mechanism",
        "consumer_repo",
        "target",
        "publish_strategy",
        "next_commands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "consumer_repo": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "publish_strategy": {
          "type": "string",
          "minLength": 1
        },
        "next_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "checks",
        "blockers",
        "warnings"
      ],
      "properties": {
        "tier": {
          "enum": [
            "QUICK",
            "STANDARD",
            "FULL",
            "CRITICAL"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "BLOCKED",
            "PENDING_APPROVAL",
            "APPROVED"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "packet_ref",
        "evidence_ref",
        "event_ref",
        "published_at",
        "result"
      ],
      "properties": {
        "mode": {
          "const": "REPORT_ONLY_HANDOFF"
        },
        "packet_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "timestamp",
          "actor",
          "result"
        ],
        "properties": {
          "action": {
            "enum": [
              "PREPARE",
              "APPROVE",
              "PUBLISH"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "$ref": "content_fixture.schema.json#/properties/provenance"
    }
  }
}
