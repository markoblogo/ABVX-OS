{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External shelf cluster V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "label",
    "frozen_at",
    "routes",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "external-shelf-cluster/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "definition",
          "marketplace"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
          },
          "kind": {
            "enum": [
              "QUERY",
              "CATEGORY",
              "AUTHOR",
              "SERIES",
              "DIRECT_PRODUCT",
              "OTHER"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "marketplace": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
