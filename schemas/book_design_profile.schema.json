{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/book-design-profile/v1",
  "title": "ABVX Book Design Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "publication_profile",
    "renderer_family",
    "structure_defaults",
    "human_gates",
    "qa_profile",
    "tokens",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["PROOF_REQUIRED", "ADMITTED", "REJECTED", "DEPRECATED"]
    },
    "publication_profile": {
      "enum": ["CONVENTIONAL_BOOK", "DISCOVERY_BOOKLET", "HANDBOOK", "REPORT"]
    },
    "renderer_family": {
      "enum": ["PANDOC_XELATEX", "HTML_CSS_CHROMIUM", "UNDECIDED"]
    },
    "structure_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_title_page",
        "headed_intro",
        "mandatory_chapters",
        "entry_layout",
        "closing_length",
        "screen_first"
      ],
      "properties": {
        "internal_title_page": { "type": "boolean" },
        "headed_intro": { "type": "boolean" },
        "mandatory_chapters": { "type": "boolean" },
        "entry_layout": { "enum": ["FLOWING_PROSE", "COMPACT_CARD", "MIXED"] },
        "closing_length": { "enum": ["SHORT", "STANDARD", "LONG"] },
        "screen_first": { "type": "boolean" }
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "enum": [
          "RIGHTS_OR_SCOPE",
          "VOICE_OR_EDITORIAL_DIRECTION",
          "VISUAL_DIRECTION",
          "EXTERNAL_PUBLICATION"
        ]
      }
    },
    "qa_profile": {
      "type": "array",
      "items": {
        "enum": [
          "REQUIRED_SECTIONS",
          "CANONICAL_LINKS",
          "PAGE_COUNT_SANITY",
          "TEXT_LAYER",
          "LINKS_CLICKABLE",
          "NO_OVERFLOW_IF_DETECTABLE",
          "PUBLICATION_PACKET",
          "PRINT_TOC_PAGE_NUMBERS",
          "CHAPTER_STARTS_NEW_PAGE",
          "PAGE_BALANCE",
          "HEADING_HYPHENATION",
          "BODY_HYPHENATION_RATE",
          "READER_NOTES_CLEAN",
          "FULL_BOOK_CONTACT_SHEET",
          "KINDLE_PRINT_LEAKAGE"
        ]
      }
    },
    "production_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PRINT_TOC_REQUIRES_PAGE_NUMBERS",
          "KINDLE_TOC_HAS_NO_PRINT_PAGINATION",
          "CHAPTER_STARTS_NEW_PAGE",
          "PRE_CHAPTER_PAGE_BALANCE_REQUIRED",
          "NO_HEADING_HYPHENATION",
          "BODY_HYPHENATION_LIMITED",
          "NO_PROVISIONAL_COPYRIGHT_TEXT",
          "NO_INTERNAL_PROVENANCE_IN_READER_NOTES",
          "INTERIOR_VISUALS_OPT_IN",
          "FULL_BOOK_CONTACT_SHEET_REQUIRED_BEFORE_PROFILE_ADMISSION",
          "TECHNICAL_QA_DOES_NOT_EQUAL_VISUAL_QA",
          "KNOWN_PROFILE_FAST_PATH"
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatible", "not_automatically_compatible"],
      "properties": {
        "compatible": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "not_automatically_compatible": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_project", "acceptance_evidence_ref", "approved_at", "supported_publication_class", "renderer_toolchain", "qa_contract_refs", "human_gate_required"],
      "properties": {
        "acceptance_project": { "type": "string", "minLength": 1 },
        "acceptance_evidence_ref": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "supported_publication_class": { "type": "string", "minLength": 1 },
        "renderer_toolchain": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "qa_contract_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "human_gate_required": { "type": "boolean" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "body_font",
        "heading_font",
        "body_size_pt",
        "accent_color",
        "content_width_ratio",
        "vertical_spacing",
        "fact_label_style",
        "link_style",
        "verdict_style"
      ],
      "properties": {
        "page": { "type": "string", "minLength": 1 },
        "body_font": { "type": "string", "minLength": 1 },
        "heading_font": { "type": "string", "minLength": 1 },
        "body_size_pt": { "type": "number", "minimum": 1 },
        "accent_color": { "type": "string", "minLength": 1 },
        "content_width_ratio": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
        "vertical_spacing": { "type": "string", "minLength": 1 },
        "fact_label_style": { "type": "string", "minLength": 1 },
        "link_style": { "type": "string", "minLength": 1 },
        "verdict_style": { "type": "string", "minLength": 1 }
      }
    },
    "notes": { "type": ["string", "null"] },
    "provenance": {
      "$ref": "evidence.schema.json#/$defs/provenance"
    }
  }
}
