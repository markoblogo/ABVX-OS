{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/book-research-source-document/v1",
  "title": "ABVX Book Research Source Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_id",
    "title",
    "source_kind",
    "locator",
    "processing_mode",
    "paragraph_count",
    "unique_external_urls",
    "language_mix",
    "topical_sections",
    "owner_project_mentions",
    "selected_reference_domains",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["DOCX", "PDF", "MARKDOWN", "TXT"] },
    "locator": { "type": "string", "minLength": 1 },
    "processing_mode": { "enum": ["LOCAL_LLM", "CODEX_ASSISTED_DETERMINISTIC"] },
    "paragraph_count": { "type": "integer", "minimum": 1 },
    "unique_external_urls": { "type": "integer", "minimum": 0 },
    "language_mix": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "topical_sections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "owner_project_mentions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "selected_reference_domains": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
