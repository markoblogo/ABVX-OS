{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/ukrainian-modernism-radar-acceptance/v1",
  "title": "Ukrainian Modernism Radar Infrastructure Acceptance V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "acceptance_id", "observed_at", "observation_time_precision", "scope", "result", "full_research_status", "selection_production_status", "seeds", "evidence", "external_tools"],
  "properties": {
    "schema_version": {"const": "ukrainian-modernism-radar-infra-acceptance/v1"},
    "acceptance_id": {"const": "UKRAINIAN_MODERNISM_RADAR_INFRA_ACCEPTANCE_V1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "observation_time_precision": {"const": "DATE_ONLY_UTC_MIDNIGHT_PLACEHOLDER"},
    "scope": {"const": "FIVE_SEED_INFRASTRUCTURE_TEST_ONLY"},
    "result": {"enum": ["PASS", "PARTIAL", "FAIL"]},
    "full_research_status": {"const": "NOT_STARTED"},
    "selection_production_status": {"const": "NONE"},
    "seeds": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/seed"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "external_tools": {"type": "object", "additionalProperties": false, "required": ["epubcheck", "ace", "keepa", "kdp_scout"], "properties": {"epubcheck": {"const": "NOT_PILOTED_ENVIRONMENT_BLOCKED"}, "ace": {"const": "NOT_PILOTED_ENVIRONMENT_BLOCKED"}, "keepa": {"const": "DEFERRED_NO_SUBSCRIPTION"}, "kdp_scout": {"const": "NOT_INTEGRATED_FUTURE_PILOT_ONLY"}}}
  },
  "$defs": {
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["seed_id", "author_identity", "work_identity", "rights_evidence", "translation_evidence", "source_evidence_ids", "size_evidence_ids", "representativeness_evidence_ids", "status", "evidence_ids"],
      "properties": {
        "seed_id": {"type": "string", "minLength": 1},
        "author_identity": {"type": "object", "additionalProperties": false, "required": ["preferred_name", "name_variants", "identity_status", "evidence_ids"], "properties": {"preferred_name": {"type": "string"}, "name_variants": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "identity_status": {"enum": ["SUPPORTED", "UNCERTAIN", "NOT_ASSESSED"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
        "work_identity": {"type": "object", "additionalProperties": false, "required": ["title_variants", "original_publication_date", "evidence_ids"], "properties": {"title_variants": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "original_publication_date": {"type": ["string", "null"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
        "rights_evidence": {"type": "object", "additionalProperties": false, "required": ["author", "death_date", "death_date_source_ids", "original_publication_date", "edition_date", "jurisdiction", "applicable_term", "source_edition_status", "decision", "evidence_ids", "review_date"], "properties": {"author": {"type": "string"}, "death_date": {"type": ["string", "null"]}, "death_date_source_ids": {"type": "array", "items": {"type": "string"}}, "original_publication_date": {"type": ["string", "null"]}, "edition_date": {"type": ["string", "null"]}, "jurisdiction": {"type": "string"}, "applicable_term": {"type": "string"}, "source_edition_status": {"enum": ["IDENTIFIED", "PARTIAL", "UNKNOWN"]}, "decision": {"enum": ["PASS", "FAIL", "REVIEW"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "review_date": {"type": "string", "format": "date"}}},
        "translation_evidence": {"type": "object", "additionalProperties": false, "required": ["outcome", "language", "catalogues_searched", "name_variants", "title_variants", "record_hits", "evidence_ids", "limitation"], "properties": {"outcome": {"enum": ["NO_COMPLETE_TRANSLATION_FOUND", "COMPLETE_TRANSLATION_EXISTS", "UNCERTAIN"]}, "language": {"const": "French"}, "catalogues_searched": {"type": "array", "items": {"type": "string"}}, "name_variants": {"type": "array", "items": {"type": "string"}}, "title_variants": {"type": "array", "items": {"type": "string"}}, "record_hits": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "limitation": {"type": "string", "minLength": 1}}},
        "source_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "size_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "representativeness_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["RIGHTS_REVIEW", "BIBLIOGRAPHY_REVIEW", "SOURCE_REVIEW", "SIZE_REVIEW", "REPRESENTATIVENESS_REVIEW", "UNRESOLVED"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "observed_at", "source_type", "source_name", "collection_method", "marketplace_or_catalog", "query", "entity", "raw_evidence_pointer", "normalized_value", "evidence_class", "confidence", "personalized_state", "location_context", "tool_version", "collector_version", "status", "error_class", "notes"], "properties": {"schema_version": {"const": "radar-evidence/v1"}, "evidence_id": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"}, "source_type": {"enum": ["AMAZON", "CATALOG", "INSTITUTIONAL", "SEARCH_ENGINE", "THIRD_PARTY_DATA", "HUMAN", "ARCHIVE", "OTHER"]}, "source_name": {"type": "string"}, "collection_method": {"enum": ["OFFICIAL_API", "CATALOGUE_QUERY", "MANUAL_WEB", "BROWSER_OBSERVATION", "FILE_IMPORT", "HUMAN_ENTRY", "OTHER"]}, "marketplace_or_catalog": {"type": "string"}, "query": {"type": ["string", "null"]}, "entity": {"type": "object", "additionalProperties": true}, "raw_evidence_pointer": {"type": "string", "minLength": 1}, "normalized_value": {"type": "object", "additionalProperties": true}, "evidence_class": {"enum": ["DIRECT_STRUCTURED_DATA", "DIRECT_PAGE_OBSERVATION", "THIRD_PARTY_HISTORICAL_DATA", "BIBLIOGRAPHIC_RECORD", "INSTITUTIONAL_SOURCE", "SEARCH_PROXY", "MANUAL_INPUT", "INFERENCE"]}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}, "personalized_state": {"enum": ["TRUE", "FALSE", "UNKNOWN"]}, "location_context": {"type": ["string", "null"]}, "tool_version": {"type": ["string", "null"]}, "collector_version": {"type": "string"}, "status": {"enum": ["SUCCESS", "NO_RESULT", "COLLECTION_FAILED", "BLOCKED", "CAPTCHA", "UNSUPPORTED_MARKETPLACE", "AUTH_REQUIRED", "RATE_LIMITED", "UNKNOWN_FAILURE"]}, "error_class": {"type": ["string", "null"]}, "notes": {"type": "array", "items": {"type": "string"}}}}
  }
}
