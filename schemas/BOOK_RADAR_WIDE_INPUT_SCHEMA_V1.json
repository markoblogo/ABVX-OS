                  "value": {
                    "enum": [
                      "PRESENT",
                      "ABSENT",
                      "UNKNOWN"
                    ]
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "observation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "value",
                  "evidence_ids",
                  "observation_ids"
                ]
              },
              "query_relevance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "enum": [
                      "PRESENT",
                      "ABSENT",
                      "UNKNOWN"
                    ]
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "observation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "value",
                  "evidence_ids",
                  "observation_ids"
                ]
              }
            },
            "required": [
              "book_serving",
              "activity",
              "entrants",
              "incumbent",
