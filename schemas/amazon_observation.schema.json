{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/amazon-observation/v1",
  "title": "ABVX Amazon Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "observed_at", "marketplace", "query", "asin", "placement_type", "organic_position", "organic_depth", "sponsored_position", "personalized_modules", "personalized_state", "signed_in_state", "delivery_location_context", "price", "bsr", "rating", "review_count", "availability", "format_linkage", "collection_method", "status", "error_class", "raw_evidence_pointer", "tool_version", "collector_version", "notes"],
  "properties": {
    "schema_version": {"const": "amazon-observation/v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "marketplace": {"type": "string", "minLength": 1},
    "query": {"type": ["string", "null"]},
    "asin": {"type": ["string", "null"]},
    "placement_type": {"enum": ["ORGANIC", "SPONSORED", "MODULE", "UNKNOWN"]},
    "organic_position": {"type": ["integer", "null"], "minimum": 1},
    "organic_depth": {"type": ["integer", "null"], "minimum": 1},
    "sponsored_position": {"type": ["integer", "null"], "minimum": 1},
    "personalized_modules": {"type": "array", "items": {"enum": ["PREVIOUSLY_VIEWED_MODULE", "SPONSORED", "RECOMMENDATION_MODULE", "OTHER"]}},
    "personalized_state": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "signed_in_state": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "delivery_location_context": {"type": ["string", "null"]},
    "price": {"type": ["object", "null"], "additionalProperties": false, "required": ["amount", "currency"], "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "minLength": 3}}},
    "bsr": {"type": ["object", "null"], "additionalProperties": false, "required": ["rank", "category"], "properties": {"rank": {"type": "integer", "minimum": 1}, "category": {"type": "string"}}},
    "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
    "review_count": {"type": ["integer", "null"], "minimum": 0},
    "availability": {"type": ["string", "null"]},
    "format_linkage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["format", "asin"], "properties": {"format": {"type": "string"}, "asin": {"type": ["string", "null"]}}}},
    "collection_method": {"enum": ["MANUAL_WEB", "BROWSER_OBSERVATION", "OFFICIAL_API", "FILE_IMPORT", "OTHER"]},
    "status": {"enum": ["SUCCESS", "NO_RESULT", "COLLECTION_FAILED", "BLOCKED", "CAPTCHA", "UNSUPPORTED_MARKETPLACE", "AUTH_REQUIRED", "RATE_LIMITED", "UNKNOWN_FAILURE"]},
    "error_class": {"type": ["string", "null"]},
    "raw_evidence_pointer": {"type": "string", "minLength": 1},
    "tool_version": {"type": ["string", "null"]},
    "collector_version": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
