{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/book-spec/v1",
  "title": "ABVX Book Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "title",
    "subtitle",
    "author",
    "language",
    "content_origin",
    "publication_form",
    "audience",
    "positioning",
    "description",
    "source_pack_id",
    "source_policy",
    "citation_policy",
    "target_words",
    "target_pages",
    "trim_size",
    "chapter_count",
    "outline",
    "illustration_policy",
    "voice_style_constraints",
    "formats",
    "format_specific_qa",
    "translation",
    "visual_narrative",
    "execution_cost",
    "kdp_metadata",
    "provenance_breakdown",
    "current_state",
    "human_approval_state",
    "expected_outcome",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "book_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": ["string", "null"] },
    "author": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "content_origin": {
      "enum": ["ORIGINAL", "DERIVED", "TRANSLATION"]
    },
    "publication_form": {
      "enum": ["PROSE_BOOK", "ILLUSTRATED_BOOK", "COMIC", "MANGA", "WEBTOON"]
    },
    "book_type": {
      "enum": ["NONFICTION", "FICTION", "GUIDE", "ESSAY_COLLECTION", "OTHER"]
    },
    "source_language": {
      "type": ["string", "null"]
    },
    "target_language": {
      "type": ["string", "null"]
    },
    "audience": { "type": "string", "minLength": 1 },
    "positioning": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source_pack_id": { "type": "string", "minLength": 1 },
    "source_policy": { "type": "string", "minLength": 1 },
    "citation_policy": { "type": "string", "minLength": 1 },
    "target_words": { "type": "integer", "minimum": 1000 },
    "target_pages": { "type": "integer", "minimum": 1 },
    "trim_size": { "type": "string", "minLength": 1 },
    "chapter_count": { "type": "integer", "minimum": 1 },
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "title", "status"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["SEED", "DRAFT", "APPROVED"]
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "illustration_policy": { "type": "string", "minLength": 1 },
    "voice_style_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "formats": {
      "type": "array",
      "items": {
        "enum": ["DIGITAL_PDF", "EPUB", "PAPERBACK_PDF", "HARDCOVER_PDF"]
      }
    },
    "format_specific_qa": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "checks"],
        "properties": {
          "format": {
            "enum": [
              "DIGITAL_PDF",
              "KINDLE_REFLOWABLE",
              "PAPERBACK_INTERIOR",
              "HARDCOVER_INTERIOR",
              "EPUB",
              "PRINT_COVER",
              "EBOOK_COVER"
            ]
          },
          "checks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_edition",
        "translation_method",
        "translation_provider",
        "translation_model",
        "glossary",
        "proper_name_policy",
        "terminology_memory",
        "style_voice_instructions",
        "segment_progress",
        "resume_checkpoint_state",
        "human_reviewed_sections",
        "qa_status",
        "rights_status"
      ],
      "properties": {
        "mode": {
          "enum": ["NOT_APPLICABLE", "TRANSLATED_EDITION", "TRANSLATED_COMIC_LOCALIZATION"]
        },
        "source_edition": {
          "type": ["string", "null"]
        },
        "translation_method": {
          "enum": ["HUMAN", "AI_ASSISTED", "AI_FIRST_HUMAN_REVIEWED", "UNKNOWN"]
        },
        "translation_provider": {
          "type": ["string", "null"]
        },
        "translation_model": {
          "type": ["string", "null"]
        },
        "glossary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proper_name_policy": { "type": "string", "minLength": 1 },
        "terminology_memory": {
          "type": ["string", "null"]
        },
        "style_voice_instructions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "segment_progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "total"],
          "properties": {
            "completed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "resume_checkpoint_state": {
          "type": ["string", "null"]
        },
        "human_reviewed_sections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "qa_status": {
          "enum": ["NOT_APPLICABLE", "NOT_STARTED", "IN_PROGRESS", "PARTIAL", "PASSED", "FAILED"]
        },
        "rights_status": {
          "enum": ["CLEAR", "MIXED", "UNKNOWN", "BLOCKED"]
        }
      }
    },
    "visual_narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "script_source",
        "text_layer_policy",
        "visual_bible_status",
        "character_consistency_strategy",
        "page_plan_status",
        "lettering_strategy",
        "reading_direction",
        "export_targets"
      ],
      "properties": {
        "mode": {
          "enum": ["NOT_APPLICABLE", "COMIC", "MANGA", "WEBTOON"]
        },
        "script_source": {
          "enum": ["ORIGINAL_SCRIPT", "ADAPTED_FROM_PROSE", "TRANSLATED_SCRIPT", "UNKNOWN"]
        },
        "text_layer_policy": {
          "enum": ["SEPARATE_STRUCTURED_TEXT_REQUIRED", "BAKED_TEXT_ALLOWED_WITH_SOURCE_COPY", "UNKNOWN"]
        },
        "visual_bible_status": {
          "enum": ["NOT_APPLICABLE", "NOT_STARTED", "PARTIAL", "READY"]
        },
        "character_consistency_strategy": {
          "type": ["string", "null"]
        },
        "page_plan_status": {
          "enum": ["NOT_APPLICABLE", "NOT_STARTED", "PARTIAL", "READY"]
        },
        "lettering_strategy": {
          "enum": ["SEPARATE_POST_PROCESS", "IN_IMAGE_ONLY", "HYBRID", "UNKNOWN"]
        },
        "reading_direction": {
          "enum": ["LEFT_TO_RIGHT", "RIGHT_TO_LEFT", "VERTICAL_SCROLL", "UNKNOWN"]
        },
        "export_targets": {
          "type": "array",
          "items": {
            "enum": ["PDF", "CBZ", "EPUB_FIXED_LAYOUT", "WEBTOON_PACKAGE", "IMAGE_SEQUENCE"]
          }
        }
      }
    },
    "execution_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_preference", "preferred_runtime_cost"],
      "properties": {
        "cost_preference": {
          "enum": ["FREE_FIRST", "BALANCED", "QUALITY_FIRST"]
        },
        "preferred_runtime_cost": {
          "enum": ["FREE_LOCAL", "FREE_TIER", "LOW_COST_API", "PAID_API", "UNKNOWN"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "kdp_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "categories", "ai_disclosure"],
      "properties": {
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ai_disclosure": {
          "enum": ["REQUIRED", "NOT_REQUIRED", "UNKNOWN"]
        }
      }
    },
    "provenance_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manuscript_text",
        "translation",
        "cover",
        "interior_illustrations",
        "diagrams",
        "appendices"
      ],
      "properties": {
        "manuscript_text": { "enum": ["HUMAN", "AI_ASSISTED", "AI_GENERATED", "TRANSLATED", "SOURCE_DERIVED", "UNKNOWN"] },
        "translation": { "enum": ["HUMAN", "AI_ASSISTED", "AI_GENERATED", "TRANSLATED", "SOURCE_DERIVED", "HUMAN_TRANSLATED", "AI_TRANSLATED", "AI_ASSISTED_TRANSLATION", "HUMAN_REVISED_AI_TRANSLATION", "UNKNOWN"] },
        "cover": { "enum": ["HUMAN", "AI_ASSISTED", "AI_GENERATED", "TRANSLATED", "SOURCE_DERIVED", "UNKNOWN"] },
        "interior_illustrations": { "enum": ["HUMAN", "AI_ASSISTED", "AI_GENERATED", "TRANSLATED", "SOURCE_DERIVED", "UNKNOWN"] },
        "diagrams": { "enum": ["HUMAN", "AI_ASSISTED", "AI_GENERATED", "TRANSLATED", "SOURCE_DERIVED", "UNKNOWN"] },
        "appendices": { "enum": ["HUMAN", "AI_ASSISTED", "AI_GENERATED", "TRANSLATED", "SOURCE_DERIVED", "UNKNOWN"] }
      }
    },
    "current_state": { "type": "string", "minLength": 1 },
    "human_approval_state": { "type": "string", "minLength": 1 },
    "expected_outcome": { "type": "string", "minLength": 1 },
    "provenance": {
      "$ref": "evidence.schema.json#/$defs/provenance"
    }
  }
}
