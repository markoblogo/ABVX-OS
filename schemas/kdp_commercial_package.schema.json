{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.example/schemas/kdp_commercial_package.schema.json",
  "type": "object",
  "required": ["content_version", "commercial_package_content_version", "primary_marketplace", "planned_formats", "format_settings", "pricing"],
  "properties": {
    "content_version": {"type":"string","minLength":1},
    "commercial_package_content_version": {"type":"string","minLength":1},
    "primary_marketplace": {"type":"string","minLength":1},
    "planned_formats": {"type":"array","minItems":1,"items":{"type":"string"}},
    "format_settings": {"type":"object"},
    "pricing": {
      "type":"object",
      "required":["price_status","final_price_version","final_content_version","final_layout_version","formats"],
      "properties": {
        "price_status":{"enum":["FINAL","PROVISIONAL","RECALCULATION_REQUIRED"]},
        "final_price_version":{"type":"string","minLength":1},
        "final_content_version":{"type":"string","minLength":1},
        "final_layout_version":{"type":"string","minLength":1},
        "formats":{"type":"object"}
      }
    }
  }
}
