{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/publishing-adapter/v1",
  "title": "ABVX Publishing Adapter Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project",
          "surface",
          "mechanism",
          "consumer_repo",
          "target",
          "publish_strategy",
          "readiness",
          "readiness_reason",
          "required_assets",
          "next_commands",
          "validation",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "consumer_repo": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "publish_strategy": {
            "enum": [
              "code_array",
              "file_markdown",
              "playbook_handoff",
              "future_surface"
            ]
          },
          "readiness": {
            "enum": [
              "READY",
              "BLOCKED"
            ]
          },
          "readiness_reason": {
            "type": "string",
            "minLength": 1
          },
          "required_assets": {
            "type": "boolean"
          },
          "preparation_blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default_tier",
              "checks"
            ],
            "properties": {
              "default_tier": {
                "enum": [
                  "QUICK",
                  "STANDARD",
                  "FULL",
                  "CRITICAL"
                ]
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recorded_by",
              "source_uri",
              "observed_at"
            ],
            "properties": {
              "recorded_by": {
                "type": "string",
                "minLength": 1
              },
              "source_uri": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
