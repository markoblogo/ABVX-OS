{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/intelligence-research-relevance-ranking-output/v1",
  "title": "ABVX Intelligence Research Relevance Ranking Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ranked_items",
    "high_risk_items",
    "notes"
  ],
  "properties": {
    "ranked_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter_id",
          "relevance",
          "verification_priority",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "chapter_id": { "type": "string", "minLength": 1 },
          "relevance": { "enum": ["CORE", "SUPPORT", "OPTIONAL", "EXCLUDE"] },
          "verification_priority": { "enum": ["P0", "P1", "P2"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "high_risk_items": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
