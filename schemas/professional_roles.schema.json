{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/professional-roles/v1",
  "title": "ABVX Professional Role Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": "v1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role_class", "status", "purpose", "priority", "default", "default_mode", "authority_effect", "context_scope", "capabilities", "boundaries", "triggers", "donor_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role_class": { "enum": ["coordinator", "professional"] },
          "status": { "const": "ROUTABLE_PROFILE" },
          "purpose": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "default": { "type": "boolean" },
          "default_mode": { "enum": ["coordinate", "advise", "research", "draft", "implement"] },
          "authority_effect": { "const": "none" },
          "context_scope": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "weight"],
              "properties": {
                "term": { "type": "string", "minLength": 1 },
                "weight": { "type": "integer", "minimum": 1, "maximum": 20 }
              }
            }
          },
          "donor_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
