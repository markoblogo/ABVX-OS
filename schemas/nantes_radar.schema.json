{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/nantes-radar/v1",
  "title": "ABVX opportunities / Nantes Radar import contracts v1",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "location",
        "roles",
        "skills",
        "languages",
        "facts",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "work_eligibility": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "tags",
        "confirmed",
        "language",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confirmed": {
          "type": "boolean"
        },
        "language": {
          "enum": [
            "en",
            "fr"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "company",
        "url",
        "location",
        "work_mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "work_mode": {
          "enum": [
            "onsite",
            "hybrid",
            "remote",
            "UNKNOWN"
          ]
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "remote_scope": {
          "type": "string",
          "minLength": 1
        },
        "eligible_countries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_languages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "eligibility": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "unreachable"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "requisition_id": {
          "type": "string",
          "minLength": 1
        },
        "posted_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "status",
        "source_refs",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "vacancy",
            "platform",
            "creative_call",
            "client_project",
            "employment_prospect",
            "UNKNOWN"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "notes": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "linked_job_id": {
          "type": "string",
          "minLength": 1
        },
        "application_status": {
          "type": "string",
          "minLength": 1
        },
        "owner_decision": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "claim",
              "source_role",
              "source_ref",
              "occurred_at"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "source_role": {
                "enum": [
                  "user",
                  "assistant",
                  "saved_automation",
                  "tool"
                ]
              },
              "source_ref": {
                "type": "string"
              },
              "occurred_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "status",
        "occurred_at",
        "source_refs",
        "notes"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "captured_at",
        "jobs"
      ],
      "properties": {
        "schema_version": {
          "const": "v1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "opportunities",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": "v1"
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opportunity"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    }
  }
}
