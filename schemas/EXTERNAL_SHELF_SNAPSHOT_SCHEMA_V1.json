      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "title",
          "identity",
          "author",
          "publisher",
          "series",
          "position",
          "price",
          "review_count",
          "rating",
