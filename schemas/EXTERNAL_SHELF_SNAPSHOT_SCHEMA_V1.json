{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External shelf snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "origin",
    "cluster",
    "route_id",
    "observed_at",
    "context",
    "repeat_of",
    "evidence",
    "products",
    "absences",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "external-shelf-snapshot/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "origin": {
      "enum": [
        "SYNTHETIC",
        "RETAINED"
      ]
    },
    "cluster": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "External shelf cluster V1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "label",
        "frozen_at",
        "routes",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "external-shelf-cluster/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "definition",
              "marketplace"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
              },
              "kind": {
                "enum": [
                  "QUERY",
                  "CATEGORY",
                  "AUTHOR",
                  "SERIES",
                  "DIRECT_PRODUCT",
                  "OTHER"
                ]
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "marketplace": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "route_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketplace",
        "route_definition",
        "device",
        "surface",
        "signed_in",
        "delivery",
        "locale",
        "sort_order",
        "filters",
        "depth_requested",
        "depth_reached",
        "depth_complete",
        "capture_policy"
      ],
      "properties": {
        "marketplace": {
          "type": "string",
          "minLength": 1
        },
        "route_definition": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "signed_in": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
