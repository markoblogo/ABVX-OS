          },
          "kind": {
            "enum": [
              "TEXT",
              "IMAGE",
              "HTML",
              "JSON",
              "OTHER"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
