{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.invalid/schemas/analytics-observation/v1",
  "title": "ABVX Analytics Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source",
    "project",
    "period",
    "observations",
    "confidence",
    "captured_at",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "id": { "type": "string", "minLength": 1 },
    "source": {
      "enum": [
        "plausible",
        "google_search_console",
        "future_source"
      ]
    },
    "project": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "dimension", "observation"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "dimension": { "type": ["string", "null"] },
          "observation": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ]
    },
    "captured_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_by"],
      "properties": {
        "recorded_by": { "type": "string", "minLength": 1 },
        "source_uri": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "provider": { "type": ["string", "null"] },
        "raw_ref": { "type": ["string", "null"] }
      }
    }
  }
}
