.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.tmp/
tmp/

# Personal psychology source derivatives stay local; do not commit notebook content or per-note analysis.
/psychology-warehouse/state/
/psychology-warehouse/usage/
/psychology-warehouse/reports/

# Reproducible publishing intermediates; keep final EPUB/PDF, manifests and contact sheets.
books/*/v*/production/epub-v*/
books/*/v*/qa/rendered-pages-v*/
books/*/v*/qa/pdf-bbox-v*.xhtml

# Reproducible page rasters used to assemble the canonical final contact sheet.
books/artifacts/unusual-indices-book/final-008/review/all-pages/

# Generated local bakeoff output; keep manifests and fixtures, not run logs.
evidence/bakeoffs/*/runs/*
evidence/bakeoffs/*/artifacts/*
!evidence/bakeoffs/*/runs/.gitkeep
!evidence/bakeoffs/*/artifacts/.gitkeep

# Local psychology qualification reports may include note IDs and review metadata.
/psychology-warehouse/audits/

# Operator imports and derived multi-market research state stay local.
/book-radar/multi-market/state.json
/book-radar/multi-market/evidence/

/content/drafts/

/content/publish-packets/

/evidence/content-ops/

/content/events.jsonl

# Private Psychology Notebook editorial views and source-bound decisions.
/psychology-warehouse/editorial/

# Private unified opportunity catalog: candidate facts, drafts and human history.
/opportunities/private/

# Local operational material is not a public source distribution.
/.codex/protected-snapshots/
/.pytest_cache/
/-.png
/*.log
/output/
/artifacts/
/events/
/intake/items/
/content/items/
/book-radar/audits/
/book-radar/calibration/
/book-radar/runs/
/book-radar/imports/
/book-radar/observed-actuals/
/book-radar/outcomes/
/books/*
!/books/factory/
/books/factory/*
!/books/factory/contracts/
!/books/factory/lessons/
/docs/audits/abvx-secrets-*/
/docs/audits/abvx-openai-real-*/
/docs/audits/abvx-credential-broker-openai-*/
/docs/audits/d2d-portfolio-*/

# Owner-specific journals stay local.
/ABVX_BOOK_PRODUCTION_LEARNING_REGISTRY_V1.json

# New research/evidence journals need explicit public-source review.
/book-radar/
/evidence/
/learning/
/psychology-warehouse/
