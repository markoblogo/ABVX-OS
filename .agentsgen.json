{
  "version": 1,
  "mode": "safe",
  "on_missing_markers": "error",
  "generated_suffix": ".generated",
  "markers": {
    "start": "<!-- AGENTSGEN:START section={section} -->",
    "end": "<!-- AGENTSGEN:END section={section} -->"
  },
  "sections": [
    "agentsgen_contract",
    "task_contract",
    "verification"
  ],
  "pack": {
    "enabled": true,
    "llms_format": "txt",
    "output_dir": "docs/ai",
    "files": []
  },
  "commands": {
    "install": "python3 -m pip install -r requirements-dev.txt",
    "lint": "./bin/abvx validate",
    "test": "PYTHONPATH=src python3 -m unittest discover -s tests -q"
  },
  "project": {
    "name": "ABVX-OS",
    "primary_stack": "python",
    "repo_root": "."
  }
}
