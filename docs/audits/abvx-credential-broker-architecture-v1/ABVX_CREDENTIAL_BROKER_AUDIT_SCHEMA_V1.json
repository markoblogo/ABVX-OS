{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abvx.local/schemas/credential-broker-audit-v1.json",
  "title": "ABVX Credential Broker Audit Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp", "request_id", "agent", "project", "credential_id", "provider", "operation", "execution_class", "policy_id", "request_count", "status", "duration_ms", "secret_exposed", "redaction_events", "error_class"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "timestamp": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "agent": {"type": "string", "minLength": 1, "maxLength": 128},
    "project": {"type": "string", "minLength": 1, "maxLength": 256},
    "credential_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 64},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "execution_class": {"enum": ["A", "B", "C", "D"]},
    "approval_id": {"type": ["string", "null"], "maxLength": 128},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "resource": {"type": ["object", "string", "null"]},
    "model": {"type": ["string", "null"], "maxLength": 128},
    "request_count": {"type": "integer", "minimum": 1},
    "usage": {"type": ["object", "null"], "additionalProperties": {"type": ["number", "integer", "string", "null"]}},
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "actual_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["allowed", "denied", "approval_required", "succeeded", "failed", "cancelled", "budget_exhausted"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "secret_exposed": {"const": false},
    "redaction_events": {"type": "array", "items": {"type": "string", "maxLength": 64}},
    "error_class": {"type": ["string", "null"], "maxLength": 128}
  }
}
