#!/bin/sh
# Owner-run first acquisition when the Codex sandbox has no Google connectivity.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
run_id="live-$(date -u +%Y%m%dT%H%M%SZ)"
exec "$repo_root/bin/youtube-intelligence" run --run-id "$run_id" \
    --research "$repo_root/.tmp/youtube-intelligence/research-20261019.json"
